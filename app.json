{
  "expo": {
    "name": "BallMazeEscape",
    "slug": "BallMazeEscape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1a1a2e",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vsonaljaiswal.BallMazeEscape"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android.adaptiveIcon.foregroundImage.png",
        "backgroundColor": "#C42E23"
      },
      "package": "com.vsonaljaiswal.BallMazeEscape",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "cda0fb54-9dfb-4bfa-9461-599fc68eca54"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.image.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#A7241D"
        }
      ]
    ]
  }
}
